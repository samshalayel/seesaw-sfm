{
  "name": "office-lite",
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node node_modules/concurrently/dist/bin/concurrently.js \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --env-file=.env node_modules/tsx/dist/cli.mjs watch server/index.ts",
    "dev:client": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/vite/bin/vite.js build",
    "start": "node --env-file=.env node_modules/tsx/dist/cli.mjs server/index.ts",
    "electron": "node node_modules/electron/cli.js .",
    "electron:build": "npm run build && node node_modules/electron-builder/out/cli/cli.js --win"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@react-three/drei": "^9.99.0",
    "@react-three/fiber": "^8.18.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "googleapis": "^140.0.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.85.4",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "three": "^0.170.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^36.0.0",
    "electron-builder": "^25.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "^0.28.0"
  },
  "build": {
    "appId": "com.officelite.app",
    "productName": "المكتب الذكي",
    "copyright": "© 2025",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "data/**/*",
      "node_modules/**/*",
      "package.json",
      ".env"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "data",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": ["ar", "en"],
      "language": "1025",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "المكتب الذكي"
    }
  }
}
